import os
import subprocess
import threading
import time
import gradio as gr
import qrcode
from pycloudflared import Tunnel


# Face Swapping Process Function (Target Face Lock support ပါဝင်သည်)
def run_faceswap(source_img, target_vid, target_face_index, enhancer, fidelity):
  if not source_img or not target_vid:
    return None

  output_path = "output_result.mp4"

  # Command base
  cmd = [
      "python",
      "cli.py",
      "--source",
      source_img,
      "--target",
      target_vid,
      "--output",
      output_path,
      "--execution-provider",
      "cuda",
      "--execution-threads",
      "8",
      "--color-matching",
      "seamless",
      "--target-face-index",
      str(int(target_face_index)),  # သီးသန့် မျက်နှာကို Lock ခတ်ရန် Index
  ]

  if enhancer != "none":
    cmd.extend(
        ["--face-enhancer", enhancer, "--codeformer-fidelity", str(fidelity)]
    )

  subprocess.run(cmd)
  return output_path


# Gradio Universal UI Construction
def launch_gradio():
  with gr.Blocks(title="FaceSwapper Multi-Face Target Lock") as demo:
    gr.Markdown(
        "## 🎭 FaceSwapper (Multi-Face Target Selection & Lock System)"
    )

    with gr.Row():
      # Left Column - Inputs & Options
      with gr.Column():
        src_input = gr.Image(type="filepath", label="1. Source Face Image")
        tgt_input = gr.Video(label="2. Target Video")

        gr.Markdown("---")
        gr.Markdown("### 🎯 Target Face Lock Settings")

        face_index = gr.Number(
            value=0,
            precision=0,
            label="Target Face Index (0 = First detected face, 1 = Second face, etc.)",
            info="ဗီဒီယိုထဲတွင် လူအများပါက မည်သည့်မျက်နှာကို လဲမည်နည်း (0, 1, 2... ရွေးပေးပါ)",
        )

        enhancer_opt = gr.Radio(
            ["none", "codeformer", "gfpgan"],
            value="codeformer",
            label="Face Enhancer Quality",
        )
        fidelity_slider = gr.Slider(
            0.1, 1.0, value=0.8, label="CodeFormer Fidelity"
        )

        btn = gr.Button(
            "🚀 Lock Face & Start Swap", variant="primary", size="lg"
        )

      # Right Column - Output Video
      with gr.Column():
        video_output = gr.Video(label="Output Result Video")

    btn.click(
        run_faceswap,
        inputs=[
            src_input,
            tgt_input,
            face_index,
            enhancer_opt,
            fidelity_slider,
        ],
        outputs=video_output,
    )

  demo.launch(
      server_name="0.0.0.0",
      server_port=7860,
      prevent_thread_lock=True,
      quiet=True,
  )


# Start Gradio App in Background Thread
threading.Thread(target=launch_gradio, daemon=True).start()
time.sleep(3)

# Start Cloudflare Tunnel
try:
  tunnel_url = Tunnel.start(port=7860)
  public_url = tunnel_url.get_url()
  print("\n" + "=" * 65)
  print(f"🔗 MULTI-FACE UI URL: {public_url}")
  print("=" * 65 + "\n")
  qr = qrcode.QRCode()
  qr.add_data(public_url)
  qr.print_ascii(invert=True)
except Exception as e:
  print(f"Tunnel Error: {e}")
