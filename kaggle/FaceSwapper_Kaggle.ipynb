   "source": [
    "# FaceSwapperVideoV1 — Kaggle Notebook (GPU-ready)\n",
    "\n",
    "ဤ notebook သည် Kaggle kernel ဗားရှင်းတွင် run ပြီး GPU runtime (Notebook settings -> Accelerator -> GPU) ရရှိရန် သတ်မှတ်ထားသည်။\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1) Select "GPU" as the accelerator in Kaggle Kernel settings before running this cell.\n",
    "!git clone https://github.com/Deci1337/FaceSwapperVideoV1.git\n",
    "%cd FaceSwapperVideoV1\n",
    "!python -m pip install --upgrade pip\n",
    "# Install PyTorch (match Kaggle CUDA runtime) - try CUDA 11.8 wheel if available\n",
    "!pip install torch torchvision --index-url https://download.pytorch.org/whl/cu118 -q\n",
    "!pip install -r requirements.txt -q\n",
    "print('Dependencies installed (may take several minutes)')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "import subprocess\n",
    "\n",
    "def run_swap(video_path, face_path):\n",
    "    out_dir = Path('/kaggle/working/output')\n",
    "    out_dir.mkdir(exist_ok=True, parents=True)\n",
    "    out_path = out_dir / 'result.mp4'\n",
    "    cmd = [\n",
    "        'python', 'cli.py', 'swap',\n",
    "        '--input', str(video_path),\n",
    "        '--source-face', str(face_path),\n",
    "        '--output', str(out_path),\n",
    "        '--quality', 'high',\n",
    "        '--provider', 'cuda',\n",
    "        '--keep-audio', 'true'\n",
    "    ]\n",
    "    proc = subprocess.run(cmd, capture_output=True, text=True, cwd='.')\n",
    "    if proc.returncode != 0:\n",
    "        raise RuntimeError(proc.stderr or proc.stdout or 'Face swap failed')\n",
    "    return str(out_path)\n"
   ]
  }
